[package]
name = "tauri-plugin-keep-screen-on"
version = "0.1.4"
authors = [ "Krzysztof Andrelczyk" ]
description = "A Tauri plugin that prevents screen timeout on Android and iOS"
repository = "https://gitlab.com/cristofa/tauri-plugin-keep-screen-on"
edition = "2021"
rust-version = "1.70"
links = "tauri-plugin-keep-screen-on"
license = "MIT OR Apache-2.0"
readme = "README.md"
keywords = ["tauri", "plugin", "screen", "android", "ios"]

[dependencies]
tauri = { version = "2.0.0-rc.8" }
serde = "1.0"
thiserror = "1.0"

[build-dependencies]
tauri-plugin = { version = "2.0.0-rc.7", features = ["build"] }
