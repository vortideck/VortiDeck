{
  "name": "vortideck-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "nuxt": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs dev --no-fork",
    "dev": "npx kill-port 4450 && node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs dev --no-fork --host 0.0.0.0 --port 4450",
    "generate": "nuxt generate",
    "test": "vitest run",
    "lint": "eslint --config ../../eslint.config.mjs . ../../layers/base ../../layers/configuration ../../layers/desktop ../../layers/desktop-streaming ../../layers/flow",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "tauri:dev": "dotenv -e .env -e ../../.env -- tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-notification": "2.8.0",
    "better-sqlite3": "^12.6.2",
    "nuxt": "4.5.2",
    "posthog-js": "^1.360.0",
    "rolldown": "1.2.6",
    "tauri-plugin-better-posthog": "^0.1.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@iconify-json/arcticons": "^1.2.57",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/eva": "^1.2.3",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/fluent-emoji-high-contrast": "^1.2.5",
    "@iconify-json/game-icons": "^1.2.1",
    "@iconify-json/hugeicons": "^1.2.16",
    "@iconify-json/ix": "^1.2.8",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/mage": "^1.2.4",
    "@iconify-json/material-symbols-light": "^1.2.37",
    "@iconify-json/mdi-light": "^1.2.2",
    "@iconify-json/openmoji": "^1.2.15",
    "@iconify-json/pepicons-pencil": "^1.2.3",
    "@iconify-json/pepicons-print": "^1.2.1",
    "@iconify-json/pixelarticons": "^1.2.2",
    "@iconify-json/prime": "^1.2.2",
    "@iconify-json/proicons": "^1.2.17",
    "@iconify-json/raphael": "^1.2.1",
    "@iconify-json/si": "^1.2.5",
    "@iconify-json/simple-icons": "^1.2.52",
    "@iconify-json/streamline-emojis": "^1.2.4",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.23",
    "@parcel/watcher": "2.5.6",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "dotenv-cli": "^7.4.2",
    "jsdom": "^30.0.1",
    "pug": "3.0.4",
    "vitest": "^4.1.11"
  }
}
