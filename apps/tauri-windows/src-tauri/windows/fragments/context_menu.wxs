<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <!-- Legacy Context Menu for Files (fallback for Windows 10 / "Show more options") -->
      <Component Id="ContextMenuFilesComponent" Guid="a1b2c3d4-5e6f-7890-abcd-ef1234567890">
        <RegistryKey Root="HKCR" Key="*\shell\VortiDeck">
          <RegistryValue Type="string" Value="Open with VortiDeck Assistant" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]VortiDeck.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="*\shell\VortiDeck\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]VortiDeck.exe&quot; &quot;vortideck://open_page/assistant&quot;" />
        </RegistryKey>
      </Component>

      <!-- Legacy Context Menu for Folders -->
      <Component Id="ContextMenuFoldersComponent" Guid="b2c3d4e5-6f78-9012-bcde-f12345678901">
        <RegistryKey Root="HKCR" Key="Directory\shell\VortiDeck">
          <RegistryValue Type="string" Value="Open with VortiDeck Assistant" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]VortiDeck.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Directory\shell\VortiDeck\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]VortiDeck.exe&quot; &quot;vortideck://open_page/assistant&quot;" />
        </RegistryKey>
      </Component>

      <!-- Legacy Context Menu for Directory Background -->
      <Component Id="ContextMenuDirectoryBackgroundComponent" Guid="c3d4e5f6-7890-1234-cdef-123456789012">
        <RegistryKey Root="HKCR" Key="Directory\Background\shell\VortiDeck">
          <RegistryValue Type="string" Value="Open VortiDeck Assistant Here" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]VortiDeck.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Directory\Background\shell\VortiDeck\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]VortiDeck.exe&quot; &quot;vortideck://open_page/assistant&quot;" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!--
      Registration is performed per-user by the application from a versioned,
      writable LocalAppData staging directory. MSI only removes the registration
      during uninstall; this avoids installer/runtime ownership conflicts.
    -->
    <CustomAction Id="UnregisterSparsePackage"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -Command &quot;$ErrorActionPreference='Stop'; Get-AppxPackage -Name 'VortiDeck.ShellExtension' | Remove-AppxPackage -ErrorAction Stop&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="UnregisterSparsePackage" Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
