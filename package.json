{
  "name": "vortideck",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "packages": "pnpm --filter",
    "app": "pnpm packages web-app vortideck",
    "start": "pnpm --stream -r run dev",
    "start:web": "pnpm --filter web-app run dev",
    "start:mobile": "pnpm --filter vortideck-mobile run tauri android dev",
    "start:desktop": "pnpm --filter vortideck-desktop tauri dev",
    "start:ios": "pnpm --filter vortideck-mobile run tauri ios dev",
    "build:web": "pnpm --filter web-app run build",
    "build:mobile": "pnpm --filter vortideck-mobile run tauri android build",
    "build:desktop": "pnpm --filter vortideck-desktop run tauri build",
    "build:desktop:debug": "pnpm --filter vortideck-desktop exec tauri build --debug --no-bundle",
    "build:desktop:inspect": "node scripts/build-desktop-inspection.mjs",
    "build:desktop:inspect:fresh": "node scripts/build-desktop-inspection.mjs --frontend",
    "build:ios": "pnpm --filter vortideck-mobile run tauri ios build",
    "generate:web": "pnpm --filter web-app run generate",
    "generate:mobile": "pnpm --filter vortideck-mobile run generate",
    "generate:desktop": "pnpm --filter vortideck-desktop run generate",
    "check:typescript-engine": "node scripts/check-typescript-engine.mjs",
    "check:dependency-versions": "node scripts/check-dependency-versions.mjs",
    "check:layer-boundaries": "node scripts/check-layer-boundaries.mjs",
    "lint": "eslint .",
    "lint:desktop": "eslint apps/tauri-windows layers/base layers/configuration layers/desktop layers/desktop-streaming layers/flow",
    "check:lint-gate": "eslint apps/tauri-windows/app.vue packages/plugin-sdk/test/minimal-plugin.ts",
    "check:lint-baseline": "node scripts/check-diagnostic-baseline.mjs desktop-lint",
    "check:typecheck-baseline": "node scripts/check-diagnostic-baseline.mjs desktop-typecheck",
    "check:core-clippy-baseline": "node scripts/check-diagnostic-baseline.mjs core-clippy",
    "typecheck:desktop": "pnpm --filter vortideck-desktop run typecheck",
    "typecheck:mobile": "pnpm --filter vortideck-mobile run typecheck",
    "typecheck:web": "pnpm --filter web-app run typecheck",
    "generate:plugin-sdk": "cargo run --locked --manifest-path apps/tauri-windows/libs/vortideck-pdk-gen/Cargo.toml --bin generate_plugin_sdk",
    "check:plugin-sdk-generated": "cargo run --locked --manifest-path apps/tauri-windows/libs/vortideck-pdk-gen/Cargo.toml --bin generate_plugin_sdk -- --check",
    "check:desktop:rust": "cargo check --locked --manifest-path apps/tauri-windows/src-tauri/Cargo.toml --bin VortiDeck",
    "clean:web": "pnpm --filter web-app run clean",
    "clean:mobile": "pnpm --filter vortideck-mobile run clean",
    "check:tauri-versions": "node scripts/check-tauri-versions.js",
    "cdp:info": "node scripts/cdp-inspect.mjs info",
    "cdp:screenshot": "node scripts/cdp-inspect.mjs screenshot"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@intlify/message-compiler": "^11.4.14",
      "@tauri-apps/plugin-http": "2.8.3",
      "@tauri-apps/plugin-log": "2.10.1",
      "@tauri-apps/plugin-os": "2.4.0",
      "@tauri-apps/plugin-store": "2.5.0",
