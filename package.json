      "markdown-it@>=14 <14.3.3": "14.3.3",
      "mermaid@>=11 <11.16.1": "11.16.1",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "node-forge@>=1 <1.4.2": "1.4.2",
      "nuxt-og-image": "6.10.4",
      "picomatch@<3": "2.3.2",
      "picomatch@>=3": "4.0.4",
      "postcss@>=8 <8.5.26": "8.5.26",
      "protobufjs@>=7 <7.6.5": "7.6.5",
      "sharp@<0.35.5": "0.35.5",
      "socket.io-parser@>=4 <4.2.7": "4.2.7",
      "svgo@>=4 <4.1.0": "4.1.0",
      "tar@>=7 <7.5.21": "7.5.21",
      "unhead@>=2 <2.1.13": "2.1.13",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8 <8.21.0": "8.21.0",
      "yaml@>=2 <2.8.3": "2.8.3"
    },
    "patchedDependencies": {
      "harfbuzzjs@0.10.0": "patches/harfbuzzjs@0.10.0.patch"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  },
  "workspaces": [
    "layers/*",
