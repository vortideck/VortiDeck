      "@tauri-apps/plugin-websocket": "2.5.0",
      "typescript": "npm:typescript-native-bridge@6.0.3-bridge.15.tsgo.7.0.2",
      "vite": "npm:rolldown-vite@latest",
      "@babel/core": "7.29.6",
      "@nuxt/devtools@>=3 <3.4.4": "3.4.4",
      "@opentelemetry/core@<2.8.0": "2.8.0",
